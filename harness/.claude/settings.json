{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.mjs"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/brief-gate.mjs"], "timeout": 10 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)"],
    "ask": [
      "Edit(./src/blocks/**)",
      "Edit(./src/runtime/**)",
      "Edit(./server/**)",
      "Edit(./scripts/**)",
      "Edit(./vite.config.ts)",
      "Edit(./package.json)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npx *)"
    ]
  }
}
